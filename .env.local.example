# `npm run local` discovers these Supabase values automatically.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
MONGODB_URI=mongodb://127.0.0.1:27017/stakeout
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=copy-ANON_KEY-from-npx-supabase-status-o-env
APP_ORIGIN=http://127.0.0.1:3000
ADMIN_EMAIL=your-google-account@example.com
INVITE_EMAIL_PROVIDER=mailpit
INVITE_EMAIL_FROM=Stakeout <invites@stakeout.local>
MAILPIT_SMTP_HOST=127.0.0.1
MAILPIT_SMTP_PORT=54325
